{
  // Type-checks the end-to-end suite, the fixture scripts, the type tests and the unit test
  // helpers, which the main tsconfig does not include. Nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "include": ["e2e", "scripts", "src/__tests__/declaredTypes.test.ts", "src/**/__tests__/helpers"],
  "exclude": ["node_modules", "dist"]
}
