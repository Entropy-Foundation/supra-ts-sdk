{
  // Type-checks the end-to-end suite, the fixture scripts and the type tests, which the main
  // tsconfig does not include. Nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "include": ["e2e", "scripts", "src/__tests__/declaredTypes.test.ts"],
  "exclude": ["node_modules", "dist"]
}
