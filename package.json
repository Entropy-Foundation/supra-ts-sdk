{
  "name": "supra-ts-sdk",
  "version": "2.0.0",
  "description": "A TypeScript SDK for interacting with the Supra blockchain and Move smart contracts. Provides type-safe utilities for transactions, contract calls, and on-chain data.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entropy-Foundation/supra-ts-sdk.git"
  },
  "homepage": "https://github.com/Entropy-Foundation/supra-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/Entropy-Foundation/supra-ts-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compatibility.json": "./compatibility.json"
  },
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "compatibility.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm build",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.e2e.config.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "check:jsdoc": "tsx scripts/check-jsdoc-examples.ts",
    "examples": "pnpm build && tsx examples/runAll.ts",
    "check:exports": "attw --pack .",
    "check:module-resolution": "tsx scripts/check-module-resolution.ts",
    "doc": "typedoc --out docs src/index.ts --sort source-order --sort instance-first --readme README.md"
  },
  "keywords": [
    "supra",
    "supra-ts-sdk",
    "supra-l1-sdk",
    "supra-l1",
    "supra-blockchain",
    "supra-sdk",
    "supra-typescript",
    "supra-javascript",
    "move",
    "move-lang",
    "move-smart-contracts",
    "move-sdk",
    "blockchain",
    "web3",
    "web3-sdk",
    "crypto",
    "dapp",
    "dapp-development",
    "smart-contracts",
    "typescript-sdk",
    "javascript-sdk"
  ],
  "author": "Supra",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.0",
    "expect-type": "^1.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "js-sha3": "^0.9.3",
    "supra-l1-sdk-core": "^2.0.1"
  },
  "pnpm": {
    "overrides": {
      "@jest/transform": "^29.7.0",
      "babel-jest": "^29.7.0",
      "jest-util": "^29.7.0",
      "@jest/types": "^29.6.3",
      "handlebars": "^4.7.10",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@humanfs/node": "^0.16.8",
      "ajv@6": "^6.14.0",
      "picomatch": "^4.0.4",
      "flatted": "^3.4.2",
      "rollup": "^4.59.0",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "js-yaml@3": "^3.15.2",
      "linkify-it": "^5.0.1",
      "markdown-it": "^14.3.1",
      "yaml": "^2.8.3",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1"
    }
  }
}